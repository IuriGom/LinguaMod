                "duecento",
                "200"
              ],
              "explanation": "'Duecento' = 200 — due + cento, one word. Trecento (300), quattrocento (400) follow the same pattern.",
              "dictionaryRefs": [
                "cento",
                "il-libro",
                "costare"
              ]
            },
