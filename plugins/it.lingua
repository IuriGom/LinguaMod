  ],
  "stories": [
    {
      "id": "story1",
      "title": "Al bar",
      "unlockAfterUnit": 5,
      "nodes": [
        {
          "id": "n1",
          "speaker": "Narratore",
          "textIt": "È sera. Tu sei al bar. La barista sorride. Cosa dici?",
          "textEn": "It's evening. You are at the café. The barista smiles. What do you say?",
          "choices": [
            {
              "text": "Buonasera!",
              "next": "n2",
              "correct": true
            },
            {
              "text": "Buongiorno!",
              "next": "n1",
              "correct": false,
              "feedbackEn": "Buongiorno is for the morning. It's evening — greet her with buonasera."
            },
            {
              "text": "Come ti chiami?",
              "next": "n1",
              "correct": false,
              "feedbackEn": "Greet first, then ask names. In Italian, as in English, you open with a greeting: buonasera."
            }
          ]
        },
        {
          "id": "n2",
          "speaker": "Giulia (barista)",
          "textIt": "Buonasera! Come ti chiami?",
          "textEn": "Good evening! What's your name?",
          "choices": [
            {
              "text": "Mi chiamo Alex.",
              "next": "n3",
              "correct": true
            },
            {
              "text": "Io chiamo Alex.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "Italian uses the reflexive: mi chiamo, literally 'I call myself'. Io chiamo Alex would mean 'I call Alex (on the phone)'."
            },
            {
              "text": "Sì, grazie.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "She asked your name — not a yes/no question. Answer with mi chiamo + your name."
            }
          ]
        },
        {
          "id": "n3",
          "speaker": "Giulia (barista)",
          "textIt": "Piacere, Alex! Io sono Giulia. E tu, di dove sei?",
          "textEn": "Nice to meet you, Alex! I'm Giulia. And you, where are you from?",
          "choices": [
            {
              "text": "Sono americano.",
              "next": "n4",
              "correct": true
            },
            {
              "text": "Sono un americano.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "With essere + a nationality, drop the article: sono americano, not sono un americano."
            },
            {
              "text": "Sono di americano.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "Di dove sei asks where you're from, but the answer is sono + nationality: sono americano. Di doesn't combine with the adjective."
            }
          ]
        },
        {
          "id": "n4",
          "speaker": "Giulia (barista)",
          "textIt": "E come si scrive il tuo nome, Alex?",
          "textEn": "And how do you spell your name, Alex?",
          "choices": [
            {
              "text": "A-L-E-X.",
              "next": "n5",
              "correct": true
            },
            {
              "text": "Sì, si scrive Alex.",
              "next": "n4",
              "correct": false,
              "feedbackEn": "Come si scrive asks you to spell it letter by letter. Say the letters: A-L-E-X."
            },
            {
              "text": "Il mio nome è Alex.",
              "next": "n4",
              "correct": false,
              "feedbackEn": "That answers what your name is, not how it's written. Spell it out: A-L-E-X."
            }
          ]
        },
        {
          "id": "n5",
          "speaker": "Giulia (barista)",
          "textIt": "Quanti anni hai, Alex?",
          "textEn": "How old are you, Alex?",
          "choices": [
            {
              "text": "Ho venti anni.",
              "next": "n6",
              "correct": true
            },
            {
              "text": "Sono venti anni.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "Age uses avere (to have), not essere: ho venti anni, literally 'I have twenty years'."
            },
            {
              "text": "Ho venti anno.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "Almost! After a number, anno becomes plural: ho venti anni."
            }
          ]
        },
        {
          "id": "n6",
          "speaker": "Giulia (barista)",
          "textIt": "Hai un telefono, Alex?",
          "textEn": "Do you have a phone, Alex?",
          "choices": [
            {
              "text": "Sì, ho un telefono.",
              "next": "n7",
              "correct": true
            },
            {
              "text": "Sì, sono un telefono.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "Sono un telefono means 'I am a phone'! Possession uses avere: ho un telefono."
            },
            {
              "text": "No, grazie.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "She isn't offering you anything — she asked whether you have a phone. Answer: sì, ho un telefono."
            }
          ]
        },
        {
          "id": "n7",
          "speaker": "Giulia (barista)",
          "textIt": "Qual è il tuo numero?",
          "textEn": "What's your (phone) number?",
          "choices": [
            {
              "text": "Il mio numero è tre due uno, cinque cinque cinque.",
              "next": "n8",
              "correct": true
            },
            {
              "text": "Il numero sono tre due uno.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "A number 'is' something — use è (third person): il mio numero è tre due uno… Sono is 'I am / they are'."
            },
            {
              "text": "C'è tre due uno.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "C'è means 'there is'. For your phone number, say: il mio numero è …"
            }
          ]
        },
        {
          "id": "n8",
          "speaker": "Narratore",
          "textIt": "Giulia sorride. Ora tu inviti Giulia al bar. Cosa dici?",
          "textEn": "Giulia smiles. Now you invite Giulia to the café. What do you say?",
          "choices": [
            {
              "text": "Giulia... al bar con me?",
              "next": "n9",
              "correct": true
            },
            {
              "text": "Giulia è al bar.",
              "next": "n8",
              "correct": false,
              "feedbackEn": "That's a statement about Giulia, not an invitation. Invite her: al bar con me?"
            },
            {
              "text": "Dove sei, Giulia?",
              "next": "n8",
              "correct": false,
              "feedbackEn": "She's right in front of you! Dove sei asks where someone is. Invite her instead: al bar con me?"
            }
          ]
        },
        {
          "id": "n9",
          "speaker": "Giulia (barista)",
          "textIt": "Sì! Al bar con te, Alex. Grazie!",
          "textEn": "Yes! To the café with you, Alex. Thank you!",
          "choices": [
            {
              "text": "Ciao, Giulia! Grazie!",
              "next": "n10",
              "correct": true
            },
            {
              "text": "No, grazie.",
              "next": "n9",
              "correct": false,
              "feedbackEn": "You invited her and she said yes — don't decline your own invitation! Close with a warm ciao."
            },
            {
              "text": "Buongiorno, Giulia.",
              "next": "n9",
              "correct": false,
              "feedbackEn": "It's still evening — and the conversation is ending. Close with ciao or buonasera."
            }
          ]
        },
        {
          "id": "n10",
          "speaker": "Narratore",
          "textIt": "Giulia sorride e scrive il numero. Tu hai il numero di Giulia. Al bar, con Giulia — bravo, Alex!",
          "textEn": "Giulia smiles and writes down her number. You have Giulia's number. The café, with Giulia — well done, Alex!",
          "terminal": true
        }
      ]
    },
    {
      "id": "story2",
      "title": "Il ristorante",
      "unlockAfterUnit": 15,
      "nodes": [
        {
          "id": "n1",
          "speaker": "Narratore",
          "textIt": "È sera. Tu e Giulia siete al ristorante. Il cameriere arriva. Cosa dici?",
          "textEn": "It's evening. You and Giulia are at the restaurant. The waiter arrives. What do you say?",
          "choices": [
            {
              "text": "Buonasera! Un tavolo per due, per favore.",
              "next": "n2",
              "correct": true
            },
            {
              "text": "Buongiorno! Un tavolo per due.",
              "next": "n1",
              "correct": false,
              "feedbackEn": "It's sera (evening) — greet with buonasera, not buongiorno."
            },
            {
              "text": "Vorrei un cappuccino.",
              "next": "n1",
              "correct": false,
              "feedbackEn": "Cappuccino is a morning drink — and first you need a table: 'Un tavolo per due, per favore.'"
            }
          ]
        },
        {
          "id": "n2",
          "speaker": "Cameriere",
          "textIt": "Buonasera! Ecco il menu. Cosa prendi?",
          "textEn": "Good evening! Here is the menu. What are you having?",
          "choices": [
            {
              "text": "Per me la pasta. E tu, Giulia?",
              "next": "n3",
              "correct": true
            },
            {
              "text": "Io sono la pasta.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "Sono means 'I am' — that says 'I am the pasta'! Order with prendere: 'Per me la pasta' or 'Prendo la pasta.'"
            },
            {
              "text": "Io prendo il pasta.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "Pasta is feminine: LA pasta. 'Prendo la pasta.' — or simply 'Per me la pasta.'"
            }
          ]
        },
        {
          "id": "n3",
          "speaker": "Cameriere",
          "textIt": "Bene. E da bere? Vino o acqua?",
          "textEn": "Good. And to drink? Wine or water?",
          "choices": [
            {
              "text": "Un vino e un'acqua, per favore.",
              "next": "n4",
              "correct": true
            },
            {
              "text": "Un vino e una acqua, per favore.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "Acqua is feminine and starts with a vowel — the article drops to un': un'acqua (Unit 9)."
            },
            {
              "text": "Uno vino, per favore.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "Vino starts with a regular consonant — uno is only for s+consonant, z, gn, ps. Say: un vino."
            }
          ]
        },
        {
          "id": "n4",
          "speaker": "Cameriere",
          "textIt": "Grazie! Buon appetito!",
          "textEn": "Thank you! Enjoy your meal!",
          "choices": [
            {
              "text": "Grazie!",
              "next": "n5",
              "correct": true
            },
            {
              "text": "Buon appetito a te!",
              "next": "n4",
              "correct": false,
              "feedbackEn": "Kind thought, but the cameriere isn't eating — answer a good wish with a simple 'Grazie!'"
            },
            {
              "text": "Il conto, per favore.",
              "next": "n4",
              "correct": false,
              "feedbackEn": "Too soon! The dinner is starting. You ask for il conto at the END."
            }
          ]
        },
        {
          "id": "n5",
          "speaker": "Giulia",
          "textIt": "E tu, Alex? Hai fratelli o sorelle?",
          "textEn": "And you, Alex? Do you have brothers or sisters?",
          "choices": [
            {
              "text": "Sì, ho un fratello. Si chiama Marco.",
              "next": "n6",
              "correct": true
            },
            {
              "text": "Sì, sono un fratello.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "Family uses avere: HO un fratello (I have a brother). 'Sono un fratello' says you ARE a brother."
            },
            {
              "text": "Sì, ho una fratello.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "Fratello is masculine — un fratello, not una fratello. (Una sorella, una madre are feminine.)"
            }
          ]
        },
        {
          "id": "n6",
          "speaker": "Giulia",
          "textIt": "Com'è tuo fratello?",
          "textEn": "What is your brother like?",
          "choices": [
            {
              "text": "È alto e simpatico.",
              "next": "n7",
              "correct": true
            },
            {
              "text": "È alto e simpatica.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "Tuo fratello is masculine — both adjectives take -o: alto e simpatico (Unit 13 agreement)."
            },
            {
              "text": "Ha alto e simpatico.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "Descriptions use essere, not avere: È alto e simpatico. Ha = he has."
            }
          ]
        },
        {
          "id": "n7",
          "speaker": "Giulia",
          "textIt": "Parli bene l'italiano, Alex!",
          "textEn": "You speak Italian well, Alex!",
          "choices": [
            {
              "text": "Grazie! Studio molto.",
              "next": "n8",
              "correct": true
            },
            {
              "text": "Grazie! Parlo bene l'italiana.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "The language is l'italiano (masculine): parlo bene l'italiano."
            },
            {
              "text": "Sì, sono italiano.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "Careful — that claims you ARE Italian (and you said sei americano in Story 1). Accept the compliment: 'Grazie!'"
            }
          ]
        },
        {
          "id": "n8",
          "speaker": "Narratore",
          "textIt": "La cena finisce. Tu vuoi il conto. Cosa dici al cameriere?",
          "textEn": "The dinner ends. You want the bill. What do you say to the waiter?",
          "choices": [
            {
              "text": "Il conto, per favore.",
              "next": "n9",
              "correct": true
            },
            {
              "text": "Il menu, per favore.",
              "next": "n8",
              "correct": false,
              "feedbackEn": "The menu is for the beginning of the dinner. At the end you ask for il conto — the bill."
            },
            {
              "text": "Sono il conto.",
              "next": "n8",
              "correct": false,
              "feedbackEn": "Sono = I am — that says 'I am the bill'! Ask for it: 'Il conto, per favore.'"
            }
          ]
        },
        {
          "id": "n9",
          "speaker": "Narratore",
          "textIt": "La cena è finita. Tu e Giulia siete contenti. Cosa dici a Giulia?",
          "textEn": "The dinner is over. You and Giulia are happy. What do you say to Giulia?",
          "choices": [
            {
              "text": "Vuoi un caffè con me?",
              "next": "n10",
              "correct": true
            },
            {
              "text": "Vuoi un cappuccino con me?",
              "next": "n9",
              "correct": false,
              "feedbackEn": "Cappuccino is a morning drink (Unit 9)! After dinner, Italians take a caffè — an espresso."
            },
            {
              "text": "Vuoi una pizza con me?",
              "next": "n9",
              "correct": false,
              "feedbackEn": "You just finished dinner! Offer a caffè instead: 'Vuoi un caffè con me?'"
            }
          ]
        },
        {
          "id": "n10",
          "speaker": "Giulia",
          "textIt": "Sì! Un caffè con te, Alex. Grazie per la cena!",
          "textEn": "Yes! A coffee with you, Alex. Thank you for the dinner!",
          "choices": [
            {
              "text": "Grazie a te, Giulia. Ciao!",
              "next": "n11",
              "correct": true
            },
            {
              "text": "Buongiorno, Giulia!",
              "next": "n10",
              "correct": false,
              "feedbackEn": "It's night — close with buonasera or ciao, not buongiorno."
            },
            {
              "text": "Il conto, Giulia!",
              "next": "n10",
              "correct": false,
              "feedbackEn": "Giulia isn't the cameriere — and the bill is paid. Say goodbye warmly: 'Ciao!'"
            }
          ]
        },
        {
          "id": "n11",
          "speaker": "Narratore",
          "textIt": "Giulia sorride: 'Ciao, Alex! A presto!' La cena con Giulia è finita bene. Bravissimo, Alex!",
          "textEn": "Giulia smiles: 'Bye, Alex! See you soon!' (a presto) The dinner with Giulia ended well. Well done, Alex!",
          "terminal": true
        }
      ]
    },
    {
      "id": "story3",
      "title": "Il messaggio",
      "unlockAfterUnit": 28,
      "nodes": [
        {
          "id": "n1",
          "speaker": "Narratore",
          "textIt": "È mattina. Ieri sera: la cena con Giulia. Ti sei divertito molto! Ora: un messaggio di Giulia. Cosa fai?",
          "textEn": "It's morning. Yesterday evening: the dinner with Giulia. You had a lot of fun! Now: a message from Giulia. What do you do?",
          "choices": [
            {
              "text": "Leggo il messaggio.",
              "next": "n2",
              "correct": true
            },
            {
              "text": "Faccio colazione.",
              "next": "n1",
              "correct": false,
              "feedbackEn": "Colazione can wait — Giulia's message can't. Read it first: leggo il messaggio."
            },
            {
              "text": "Vado al bar.",
              "next": "n1",
              "correct": false,
              "feedbackEn": "The bar? Giulia messaged YOU. First read her message: leggo il messaggio."
            }
          ]
        },
        {
          "id": "n2",
          "speaker": "Giulia (messaggio)",
          "textIt": "Buongiorno, Alex! Grazie per ieri sera. Mi sono divertita molto!",
          "textEn": "Good morning, Alex! Thanks for yesterday evening. I had a lot of fun!",
          "choices": [
            {
              "text": "Mi sono divertito molto, Giulia.",
              "next": "n3",
              "correct": true
            },
            {
              "text": "Ho divertito molto.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "Divertirsi is reflexive and takes essere: mi sono divertito — never 'ho divertito'. (Unit 28.)"
            },
            {
              "text": "Mi sono divertita molto.",
              "next": "n2",
              "correct": false,
              "feedbackEn": "You're Alex — masculine: divertitO. Giulia wrote divertita because SHE is a woman. (Unit 28 agreement.)"
            }
          ]
        },
        {
          "id": "n3",
          "speaker": "Giulia (messaggio)",
          "textIt": "Hai dormito bene?",
          "textEn": "Did you sleep well?",
          "choices": [
            {
              "text": "Sì, ho dormito bene. E tu?",
              "next": "n4",
              "correct": true
            },
            {
              "text": "Sì, sono dormito bene.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "Dormire takes avere: ho dormito. Essere is for movement and change of state (andare, uscire, nascere…). (Units 26–27.)"
            },
            {
              "text": "Sì, ho dormita bene.",
              "next": "n3",
              "correct": false,
              "feedbackEn": "Two slips: dormire → dormito, and with avere the participle never agrees: ho dormito, always. (Unit 26.)"
            }
          ]
        },
        {
          "id": "n4",
          "speaker": "Giulia (messaggio)",
          "textIt": "Sì, molto bene. Alex — vuoi un caffè oggi?",
          "textEn": "Yes, very well. Alex — do you want a coffee today?",
          "choices": [
            {
              "text": "Sì! A che ora?",
              "next": "n5",
              "correct": true
            },
            {
              "text": "Sì! Ho un caffè oggi.",
              "next": "n4",
              "correct": false,
              "feedbackEn": "That says 'I'm having a coffee today' — she asked whether you WANT one (vuoi). Answer: Sì! A che ora?"
            },
            {
              "text": "No, grazie.",
              "next": "n4",
              "correct": false,
              "feedbackEn": "You want the second date! Accept and set the time: Sì! A che ora?"
            }
          ]
        },
        {
          "id": "n5",
          "speaker": "Giulia (messaggio)",
          "textIt": "Alle undici, al bar. Va bene?",
          "textEn": "At eleven, at the café. Is that OK?",
          "choices": [
            {
              "text": "Alle undici va bene!",
              "next": "n6",
              "correct": true
            },
            {
              "text": "Alle undici sono bene.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "The set phrase is VA bene (andare: va) — 'it goes well'. 'Sono bene' isn't Italian. (Unit 25.)"
            },
            {
              "text": "Va male.",
              "next": "n5",
              "correct": false,
              "feedbackEn": "Va male = it's NOT OK — you just cancelled the date! Agree: alle undici va bene."
            }
          ]
        },
        {
          "id": "n6",
          "speaker": "Narratore",
          "textIt": "Tu esci di casa. Hai due magliette: una rossa e una nera. Cosa prendi?",
          "textEn": "You leave the house. You have two t-shirts: a red one and a black one. Which do you take?",
          "choices": [
            {
              "text": "La maglietta rossa.",
              "next": "n7",
              "correct": true
            },
            {
              "text": "Il maglietta rosso.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "Maglietta is feminine: LA maglietta rossA — article and adjective both agree. (Units 5, 13, 23.)"
            },
            {
              "text": "Le magliette rossi.",
              "next": "n6",
              "correct": false,
              "feedbackEn": "You need ONE t-shirt: la maglietta rossa. The plural would be le magliette rosse."
            }
          ]
        },
        {
          "id": "n7",
          "speaker": "Giulia",
          "textIt": "Ciao Alex! Stai bene oggi!",
          "textEn": "Hi Alex! You're well today! / You look well today!",
          "choices": [
            {
              "text": "Sto molto bene! Ho una sorpresa: due biglietti per il cinema.",
              "next": "n8",
              "correct": true
            },
            {
              "text": "Sto molto bello.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "Stare pairs with bene/male — how you FEEL. Bello describes what you ARE: sei bello vs stai bene. (Unit 24.)"
            },
            {
              "text": "Ho molto bene.",
              "next": "n7",
              "correct": false,
              "feedbackEn": "Bene goes with stare: sto bene. Avere takes a noun: ho fame, ho una sorpresa. (Unit 24.)"
            }
          ]
        },
        {
          "id": "n8",
          "speaker": "Giulia",
          "textIt": "Il cinema! Quando?",
          "textEn": "The movies! When?",
          "choices": [
            {
              "text": "Domani sera, va bene?",
              "next": "n9",
              "correct": true
            },
            {
              "text": "Ieri sera, va bene?",
              "next": "n8",
              "correct": false,
              "feedbackEn": "Ieri is yesterday — the cinema is in the future. Say: domani sera, va bene?"
            },
            {
              "text": "Vado al cinema ieri.",
              "next": "n8",
              "correct": false,
              "feedbackEn": "Ieri needs the past: ieri sono andato al cinema. For plans, the present works: vado domani. (Units 16, 27.)"
            }
          ]
        },
        {
          "id": "n9",
          "speaker": "Giulia",
          "textIt": "Va bene! Domani sera. Sei un ragazzo carino, Alex.",
          "textEn": "OK! Tomorrow evening. You're a sweet boy, Alex.",
          "choices": [
            {
              "text": "Grazie, Giulia. Tu sei simpatica.",
              "next": "n10",
              "correct": true
            },
            {
              "text": "Grazie, Giulia. Tu sei simpatico.",
              "next": "n9",
              "correct": false,
              "feedbackEn": "Giulia is a woman — simpaticA. The adjective agrees with her, not with you. (Unit 13.)"
            },
            {
              "text": "Sì, sono carino.",
              "next": "n9",
              "correct": false,
              "feedbackEn": "Accept the compliment with grazie — and return it: tu sei simpatica. 💛"
            }
          ]
        },
        {
          "id": "n10",
          "speaker": "Narratore",
          "textIt": "Un caffè, un sorriso, un messaggio. Alex e Giulia: domani sera, il cinema. Bravissimo!",
          "textEn": "A coffee, a smile (un sorriso), a message. Alex and Giulia: tomorrow evening, the movies. Well done!",
          "terminal": true
        }
