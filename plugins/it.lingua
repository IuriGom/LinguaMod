          "en": "It's the best restaurant in the city."
        },
        {
          "it": "Conosco il posto migliore.",
          "en": "I know the best place."
        }
      ],
      "introducedInUnit": 37
    },
    {
      "id": "peggiore",
      "word": "peggiore",
      "translation": "worse; worst (adjective)",
      "partOfSpeech": "adjective",
      "examples": [
        {
          "it": "Il lunedì è il giorno peggiore.",
          "en": "Monday is the worst day."
        }
      ],
      "introducedInUnit": 37
    },
    {
      "id": "primo",
      "word": "primo",
      "translation": "first",
      "partOfSpeech": "adjective",
      "examples": [
        {
          "it": "Oggi è il primo giorno.",
          "en": "Today is the first day."
        },
        {
          "it": "Il primo maggio.",
          "en": "May 1st."
        }
      ],
      "introducedInUnit": 37
    },
    {
      "id": "ultimo",
