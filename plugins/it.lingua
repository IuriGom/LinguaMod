      "translation": "last",
      "partOfSpeech": "adjective",
      "examples": [
        {
          "it": "Domenica è l'ultimo giorno della settimana.",
          "en": "Sunday is the last day of the week."
        }
      ],
      "introducedInUnit": 37
    },
    {
      "id": "vero",
