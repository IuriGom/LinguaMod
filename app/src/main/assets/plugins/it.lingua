  "units": [
    {
      "id": "u1",
      "number": 1,
      "title": "Il primo incontro",
      "lessons": [
        {
          "id": "u1l1",
          "type": "vocabulary",
          "title": "Saluti",
          "dictionaryRefs": ["ciao", "buongiorno", "buonasera", "grazie", "si", "no", "piacere"],
          "exercises": [
            {
              "id": "u1l1e1", "type": "multiple_choice", "prompt": "What does it mean?",
              "question": "Ciao!",
              "options": ["Hello!", "Good night!", "Please!", "You're welcome!"],
              "correctIndex": 0,
              "explanation": "'Ciao' is the informal Italian greeting — use it with friends and people your age. It works for both 'hello' and 'goodbye'.",
              "dictionaryRefs": ["ciao"]
            },
            {
              "id": "u1l1e2", "type": "multiple_choice", "prompt": "It's 9 in the morning. How do you greet someone?",
              "question": "Scegli il saluto giusto.",
              "options": ["Buongiorno", "Buonasera", "Grazie", "Piacere"],
              "correctIndex": 0,
              "explanation": "'Buongiorno' (literally 'good day') is used from morning until the afternoon. 'Buonasera' is for the evening.",
              "dictionaryRefs": ["buongiorno"]
            },
            {
              "id": "u1l1e3", "type": "multiple_choice", "prompt": "It's 8 in the evening. How do you greet someone?",
              "question": "Scegli il saluto giusto.",
              "options": ["Buonasera", "Buongiorno", "Ciao, sono le otto", "No"],
              "correctIndex": 0,
              "explanation": "'Buonasera' is the standard greeting from late afternoon onwards. Use it when you arrive somewhere in the evening, like a bar or a restaurant.",
              "dictionaryRefs": ["buonasera"]
            },
            {
              "id": "u1l1e4", "type": "fill_blank", "prompt": "Complete the greeting for a friend.",
              "sentence": "___! Come va?",
              "answers": ["Ciao"],
              "explanation": "'Ciao' is the friendly, informal way to say hello — perfect with 'Come va?' (How's it going?).",
              "dictionaryRefs": ["ciao"]
            },
            {
              "id": "u1l1e5", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "Thank you!",
              "acceptedIt": ["Grazie!", "Grazie"],
              "explanation": "'Grazie' is always right — with anyone, in any situation. You'll also hear 'Grazie mille!' (thanks a lot).",
              "dictionaryRefs": ["grazie"]
            },
            {
              "id": "u1l1e6", "type": "translation_it_en", "prompt": "Translate to English.",
              "sourceIt": "Buonasera!",
              "acceptedEn": ["Good evening!"],
              "explanation": "'Buonasera' = 'buona' (good) + 'sera' (evening). The evening greeting.",
              "dictionaryRefs": ["buonasera"]
            },
            {
              "id": "u1l1e7", "type": "multiple_choice", "prompt": "Someone says 'Grazie!'. What did they say?",
              "question": "Grazie!",
              "options": ["Thank you!", "Yes!", "No!", "Good evening!"],
              "correctIndex": 0,
              "explanation": "'Grazie' means 'thank you'. 'Sì' means 'yes' and 'no' means 'no'.",
              "dictionaryRefs": ["grazie"]
            },
            {
              "id": "u1l1e8", "type": "fill_blank", "prompt": "Someone asks 'Sei Marco?' — answer yes.",
              "sentence": "___, sono Marco.",
              "answers": ["Sì", "Si"],
              "explanation": "'Sì' means 'yes'. The accent mark matters in writing: sì (yes) vs si (a little word you'll meet later). Both spellings are accepted here.",
              "dictionaryRefs": ["si"]
            }
          ]
        },
        {
          "id": "u1l2",
          "type": "grammar",
          "title": "Essere: io sono, tu sei",
          "dictionaryRefs": ["mi-chiamo", "come-ti-chiami"],
          "grammarNotes": "ESSERE (to be) — present tense, all six persons:\n\nio sono — I am\ntu sei — you are (informal)\nlui/lei è — he/she is\nnoi siamo — we are\nvoi siete — you are (plural)\nloro sono — they are\n\nIn this unit you need the first two: 'Io sono Marco' (I am Marco) and 'Tu sei Sara?' (Are you Sara?).\n\nSET PHRASES (learn them whole — full grammar later):\n• 'Mi chiamo Marco.' — My name is Marco. (literally: 'I call myself Marco')\n• 'Come ti chiami?' — What is your name?\n• 'Piacere di conoscerti.' — Nice to meet you.",
          "exercises": [
            {
              "id": "u1l2e1", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Io ___ Marco.",
              "answers": ["sono"],
              "explanation": "'Sono' is the io-form of essere (to be): io sono = I am. 'Io sono Marco' = I am Marco.",
              "dictionaryRefs": []
            },
            {
              "id": "u1l2e2", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Tu ___ Sara?",
              "answers": ["sei"],
              "explanation": "'Sei' is the tu-form of essere: tu sei = you are. 'Tu sei Sara?' = Are you Sara? — just add a questioning tone.",
              "dictionaryRefs": []
            },
            {
              "id": "u1l2e3", "type": "multiple_choice", "prompt": "Choose the correct form of essere.",
              "question": "Io ___ italiano.",
              "options": ["sono", "sei", "è", "siamo"],
              "correctIndex": 0,
              "explanation": "With 'io' always use 'sono': io sono = I am. 'Sei' goes with 'tu', 'è' with 'lui/lei', 'siamo' with 'noi'.",
              "dictionaryRefs": []
            },
            {
              "id": "u1l2e4", "type": "multiple_choice", "prompt": "Choose the correct form of essere.",
              "question": "Tu ___ di Roma?",
              "options": ["sei", "sono", "è", "siete"],
              "correctIndex": 0,
              "explanation": "With 'tu' always use 'sei'. 'Tu sei di Roma?' = Are you from Rome?",
              "dictionaryRefs": []
            },
            {
              "id": "u1l2e5", "type": "translation_en_it", "prompt": "Translate to Italian. (set phrase)",
              "sourceEn": "My name is Marco.",
              "acceptedIt": ["Mi chiamo Marco.", "Mi chiamo Marco", "Io mi chiamo Marco", "Io mi chiamo Marco."],
              "explanation": "Set phrase — learn it whole: 'Mi chiamo…' = My name is… (literally 'I call myself'). The grammar behind it arrives in Unit 28.",
              "dictionaryRefs": ["mi-chiamo"]
            },
            {
              "id": "u1l2e6", "type": "translation_it_en", "prompt": "Translate to English. (set phrase)",
              "sourceIt": "Come ti chiami?",
              "acceptedEn": ["What is your name?", "What's your name?"],
              "explanation": "Set phrase: 'Come ti chiami?' = What is your name? (literally 'How do you call yourself?'). The essential first question when you meet someone.",
              "dictionaryRefs": ["come-ti-chiami"]
            },
            {
              "id": "u1l2e7", "type": "fill_blank", "prompt": "Complete the set phrase.",
              "sentence": "Come ___ chiami?",
              "answers": ["ti"],
              "explanation": "In 'Come ti chiami?' the little word 'ti' means 'yourself'. For now, learn the phrase whole — the details come later.",
              "dictionaryRefs": ["come-ti-chiami"]
            },
            {
              "id": "u1l2e8", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "I am Sara. And you?",
              "acceptedIt": ["Sono Sara. E tu?", "Io sono Sara. E tu?", "Sono Sara, e tu?"],
              "explanation": "'Sono' is the io-form of essere. 'E tu?' = 'And you?' — the natural way to bounce a question back.",
              "dictionaryRefs": []
            }
          ]
        },
        {
          "id": "u1l3",
          "type": "mixed",
          "title": "Il primo incontro: ripasso",
          "dictionaryRefs": ["ciao", "buongiorno", "piacere", "grazie", "mi-chiamo"],
          "exercises": [
            {
              "id": "u1l3e1", "type": "multiple_choice", "prompt": "What does it mean?",
              "question": "Piacere di conoscerti!",
              "options": ["Nice to meet you!", "See you later!", "How are you?", "Thank you very much!"],
              "correctIndex": 0,
              "explanation": "'Piacere di conoscerti' = Nice to meet you (literally 'a pleasure to know you'). Say it right after exchanging names.",
              "dictionaryRefs": ["piacere"]
            },
            {
              "id": "u1l3e2", "type": "translation_en_it", "prompt": "Translate to Italian. (set phrase)",
              "sourceEn": "Nice to meet you!",
              "acceptedIt": ["Piacere di conoscerti!", "Piacere di conoscerti", "Piacere!", "Piacere"],
              "explanation": "Full version: 'Piacere di conoscerti'. In real life Italians often just say 'Piacere!' — both are accepted.",
              "dictionaryRefs": ["piacere"]
            },
            {
              "id": "u1l3e3", "type": "fill_blank", "prompt": "Complete the introduction.",
              "sentence": "Ciao, ___ chiamo Sara.",
              "answers": ["mi"],
              "explanation": "'Mi chiamo' = my name is. 'Mi' = myself — learn the phrase whole for now.",
              "dictionaryRefs": ["mi-chiamo", "ciao"]
            },
            {
              "id": "u1l3e4", "type": "translation_it_en", "prompt": "Translate to English.",
              "sourceIt": "Buongiorno, mi chiamo Marco.",
              "acceptedEn": ["Good morning, my name is Marco."],
              "explanation": "A complete self-introduction: greeting + 'mi chiamo' + your name.",
              "dictionaryRefs": ["buongiorno", "mi-chiamo"]
            },
            {
              "id": "u1l3e5", "type": "multiple_choice", "prompt": "You bump into a friend at a bar in the evening. You say:",
              "question": "Scegli la frase giusta.",
              "options": ["Ciao!", "Buongiorno, signore!", "Sono le otto.", "Grazie mille, arrivederci a domani!"],
              "correctIndex": 0,
              "explanation": "With a friend, 'Ciao!' is always right — morning or evening. 'Buongiorno' is only for the morning and sounds too formal here.",
              "dictionaryRefs": ["ciao"]
            },
            {
              "id": "u1l3e6", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Io ___ italiano, e tu?",
              "answers": ["sono"],
              "explanation": "io → sono. 'Io sono italiano' = I am Italian (said by a man; a woman says 'italiana' — more in Unit 2).",
              "dictionaryRefs": []
            },
            {
              "id": "u1l3e7", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "Hi! What is your name?",
              "acceptedIt": ["Ciao! Come ti chiami?", "Ciao, come ti chiami?"],
              "explanation": "'Ciao!' + 'Come ti chiami?' — the two set phrases together open every first conversation.",
              "dictionaryRefs": ["ciao", "come-ti-chiami"]
            },
            {
              "id": "u1l3e8", "type": "translation_it_en", "prompt": "Translate to English.",
              "sourceIt": "Grazie, buonasera!",
              "acceptedEn": ["Thank you, good evening!"],
              "explanation": "Two building blocks you already know: 'grazie' (thank you) and 'buonasera' (good evening).",
              "dictionaryRefs": ["grazie", "buonasera"]
            }
          ]
        },
        {
          "id": "u1l4",
          "type": "oral",
          "title": "Ascolta e parla",
          "dictionaryRefs": ["buonasera", "come-ti-chiami", "piacere", "ciao"],
          "exercises": [
            {
              "id": "u1l4e1", "type": "listening", "prompt": "Listen and choose the meaning.",
              "mode": "choice",
              "speakIt": "Buonasera!",
              "options": ["Good evening!", "Good morning!", "Goodbye!", "Thank you!"],
              "correctIndex": 0,
              "explanation": "You heard 'Buonasera!' — the evening greeting. Listen for 'sera' (evening).",
              "dictionaryRefs": ["buonasera"]
            },
