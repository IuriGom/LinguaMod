            {
              "id": "u1l4e4", "type": "listening", "prompt": "Listen and choose the meaning.",
              "mode": "choice",
              "speakIt": "Ciao, come va?",
              "options": ["Hi, how's it going?", "Hi, what's your name?", "Bye, see you tomorrow!", "Hello, good evening!"],
              "correctIndex": 0,
              "explanation": "'Come va?' = How's it going? A relaxed follow-up to 'Ciao!'.",
              "dictionaryRefs": ["ciao"]
            },
            {
              "id": "u1l4e5", "type": "speaking", "prompt": "Say it in Italian: Good morning!",
              "targetIt": "Buongiorno!",
              "minAccuracy": 0.7,
              "explanation": "'Buongiorno!' — 'gn' sounds like the 'ny' in 'canyon': bwon-JOR-no.",
              "dictionaryRefs": ["buongiorno"]
            }
          ]
        }
      ],
