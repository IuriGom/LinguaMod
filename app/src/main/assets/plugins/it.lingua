    {
      "id": "u2",
      "number": 2,
      "title": "Di dove sei?",
      "lessons": [
        {
          "id": "u2l1",
          "type": "vocabulary",
          "title": "Le nazionalità",
          "dictionaryRefs": ["italiano", "americano", "inglese", "spagnolo", "francese", "tedesco"],
          "exercises": [
            {
              "id": "u2l1e1", "type": "multiple_choice", "prompt": "What does it mean?",
              "question": "Sono italiano.",
              "options": ["I am Italian.", "I am Spanish.", "He is Italian.", "Are you Italian?"],
              "correctIndex": 0,
              "explanation": "'Sono italiano' = I am Italian (a man speaking). A woman says 'Sono italiana'.",
              "dictionaryRefs": ["italiano"]
            },
            {
              "id": "u2l1e2", "type": "multiple_choice", "prompt": "Maria is from the USA. She says:",
              "question": "Sono ___.",
              "options": ["americana", "americano", "inglese", "italiana"],
              "correctIndex": 0,
              "explanation": "Preview: nationality words change their ending with the speaker — a man is 'americano', a woman is 'americana'. We drill this fully in Unit 13.",
              "dictionaryRefs": ["americano"]
            },
            {
              "id": "u2l1e3", "type": "fill_blank", "prompt": "Luca is from Spain. Complete the sentence.",
              "sentence": "Luca è ___.",
              "answers": ["spagnolo"],
              "explanation": "'Spagnolo' = Spanish (for a man). For a woman: 'spagnola'. Nationalities are not capitalized in Italian.",
              "dictionaryRefs": ["spagnolo"]
            },
            {
              "id": "u2l1e4", "type": "fill_blank", "prompt": "Pierre is from France. Complete the sentence.",
              "sentence": "Pierre è ___.",
              "answers": ["francese"],
              "explanation": "'Francese' = French. Good news: words ending in -e stay the same for men and women.",
              "dictionaryRefs": ["francese"]
            },
            {
              "id": "u2l1e5", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "I am English. (you are a woman)",
              "acceptedIt": ["Sono inglese.", "Sono inglese", "Io sono inglese"],
              "explanation": "'Inglese' ends in -e, so it works for men and women: sono inglese.",
              "dictionaryRefs": ["inglese"]
            },
            {
              "id": "u2l1e6", "type": "translation_it_en", "prompt": "Translate to English.",
              "sourceIt": "Hans è tedesco.",
              "acceptedEn": ["Hans is German."],
              "explanation": "'Tedesco' = German (for a man; 'tedesca' for a woman). Note: the language is 'il tedesco'.",
              "dictionaryRefs": ["tedesco"]
            },
            {
              "id": "u2l1e7", "type": "multiple_choice", "prompt": "Which one means 'German'?",
              "question": "Scegli la parola giusta.",
              "options": ["tedesco", "francese", "spagnolo", "inglese"],
              "correctIndex": 0,
              "explanation": "'Tedesco' = German. 'Francese' = French, 'spagnolo' = Spanish, 'inglese' = English.",
              "dictionaryRefs": ["tedesco", "francese", "spagnolo", "inglese"]
            },
            {
              "id": "u2l1e8", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "Marco is Italian.",
              "acceptedIt": ["Marco è italiano.", "Marco è italiano", "Marco e italiano"],
              "explanation": "'È' is the lui/lei-form of essere: Marco è italiano = Marco is Italian.",
              "dictionaryRefs": ["italiano"]
            }
          ]
        },
        {
          "id": "u2l2",
          "type": "grammar",
          "title": "Essere completo e le domande",
          "dictionaryRefs": ["come", "dove", "di-dove-sei"],
          "grammarNotes": "ESSERE (to be) — the full present tense:\n\nio sono — I am\ntu sei — you are\nlui/lei è — he/she is\nnoi siamo — we are\nvoi siete — you are (plural)\nloro sono — they are\n\nNote: io sono and loro sono look the same; context tells them apart.\n\nQUESTIONS BY INTONATION: any statement becomes a question by raising your voice at the end. 'Sei italiano.' → 'Sei italiano?'\n\nQUESTION WORDS: 'come' (how), 'dove' (where). 'Di dove sei?' = Where are you from? (literally 'Of where are you?')",
          "exercises": [
            {
              "id": "u2l2e1", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Noi ___ americani.",
              "answers": ["siamo"],
              "explanation": "noi → siamo. 'Noi siamo americani' = We are American.",
              "dictionaryRefs": ["americano"]
            },
            {
              "id": "u2l2e2", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Voi ___ di Londra?",
              "answers": ["siete"],
              "explanation": "voi → siete. Use 'voi' when talking to two or more people: 'Are you (all) from London?'",
              "dictionaryRefs": []
            },
            {
              "id": "u2l2e3", "type": "fill_blank", "prompt": "Complete with essere.",
              "sentence": "Loro ___ spagnoli.",
              "answers": ["sono"],
              "explanation": "loro → sono — same word as io sono. The subject ('loro') tells you who is meant.",
              "dictionaryRefs": ["spagnolo"]
            },
            {
              "id": "u2l2e4", "type": "multiple_choice", "prompt": "Choose the correct form of essere.",
              "question": "Lei ___ francese.",
              "options": ["è", "sei", "sono", "siamo"],
              "correctIndex": 0,
              "explanation": "lui/lei → è. 'Lei è francese' = She is French.",
              "dictionaryRefs": ["francese"]
            },
            {
              "id": "u2l2e5", "type": "translation_en_it", "prompt": "Translate to Italian. (set phrase)",
              "sourceEn": "Where are you from?",
              "acceptedIt": ["Di dove sei?", "Di dove sei"],
              "explanation": "Set phrase: 'Di dove sei?' = Where are you from? Word by word: 'of where you-are?'. The classic question when you meet someone new.",
              "dictionaryRefs": ["di-dove-sei", "dove"]
            },
            {
              "id": "u2l2e6", "type": "translation_it_en", "prompt": "Translate to English.",
              "sourceIt": "Di dove sei?",
              "acceptedEn": ["Where are you from?"],
              "explanation": "'Di dove sei?' = Where are you from? 'Dove' = where; 'di' = of/from.",
              "dictionaryRefs": ["di-dove-sei"]
            },
            {
              "id": "u2l2e7", "type": "multiple_choice", "prompt": "How do you turn 'Sei italiano.' into a question?",
              "question": "Scegli la risposta giusta.",
              "options": ["Raise your voice at the end: 'Sei italiano?'", "Add 'perché' at the start", "Change 'sei' to 'sono'", "Say it twice"],
              "correctIndex": 0,
              "explanation": "Italian yes/no questions use the same words as statements — only the intonation (and the question mark) changes.",
              "dictionaryRefs": []
            },
            {
              "id": "u2l2e8", "type": "translation_en_it", "prompt": "Translate to Italian.",
              "sourceEn": "Are you English? (informal, to a man)",
              "acceptedIt": ["Sei inglese?", "Tu sei inglese?"],
              "explanation": "Statement word order + question mark: 'Sei inglese?' 'Inglese' works for men and women.",
              "dictionaryRefs": ["inglese"]
            }
          ]
        },
        {
          "id": "u2l3",
          "type": "mixed",
          "title": "Conoscersi: ripasso",
          "dictionaryRefs": ["ciao", "piacere", "italiano", "inglese", "di-dove-sei"],
          "exercises": [
            {
              "id": "u2l3e1", "type": "multiple_choice", "prompt": "Someone tells you 'Sono di Roma.' What did they say?",
              "question": "Sono di Roma.",
