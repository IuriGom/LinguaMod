              "id": "u1l4e2", "type": "listening", "prompt": "Listen and type what you hear.",
              "mode": "type",
              "speakIt": "Come ti chiami?",
              "acceptedIt": ["Come ti chiami?", "Come ti chiami"],
              "explanation": "You heard: 'Come ti chiami?' — What is your name? Listen for 'chiami' at the end.",
              "dictionaryRefs": ["come-ti-chiami"]
            },
            {
              "id": "u1l4e3", "type": "speaking", "prompt": "Say it in Italian: Nice to meet you!",
              "targetIt": "Piacere di conoscerti!",
              "minAccuracy": 0.7,
              "explanation": "'Piacere di conoscerti!' — stress the 'CIA' in piacere: pya-CHE-re.",
              "dictionaryRefs": ["piacere"]
