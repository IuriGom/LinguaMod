<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stage 9: one-time on-device model pack download (embedded TTS/STT);
         ACCESS_NETWORK_STATE only to prefer unmetered networks for the big pack. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Stage 3: speaking exercises only; requested at runtime with rationale. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Stage 4 §1: OCR camera; requested at runtime with rationale.
         The app works fully without a camera, so the feature is optional. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Package visibility so SpeechRecognizer can find the recognition service (API 30+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".LinguaModApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinguaMod">

        <!-- Stage 4 §1: UNBUNDLED ML Kit text recognizer — Play Services
             downloads the model at install/first use; never packaged here. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
